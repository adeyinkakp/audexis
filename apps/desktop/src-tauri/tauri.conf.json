{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audexis",

  "version": "0.10.1",
  "identifier": "com.kp.audexis",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "decorations": true,
        "hiddenTitle": true,
        "visible": false,
        "minHeight": 800,
        "minWidth": 1000,
        "trafficLightPosition": {
          "x": 15,
          "y": 30
        }
      }
    ],

    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },

  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net/ -a Audexis -c Audexis -d Audexis %1"
    },
    "publisher": "adeyinkakp",
    "homepage": "https://github.com/adeyinkakp/audexis"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/adeyinkakp/audexis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwN0U3RDA5NDhBMjcxMjMKUldRamNhSklDWDErOE1pdHZyRWlKaVlMTjRJNTlQN1pyT08rRUxISzhyOHNPVEF2SE1sTTFnN2gK"
    }
  }
}
