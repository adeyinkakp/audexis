{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:frontend": "pnpm run typecheck && pnpm run test:frontend && pnpm run build:frontend",
    "validate:rust": "pnpm run format:check && pnpm run check:rust && pnpm run clippy && pnpm run test:rust",
    "validate": "pnpm run validate:frontend && pnpm run validate:rust",
    "tauri": "tauri",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@audexis/shared": "workspace:*",
    "@dnd-kit/abstract": "^0.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-log": "~2.9.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.4.4",
    "clsx": "^2.1.1",
    "lrclib-api": "^2.2.0",
    "lucide-react": "^1.27.0",
    "motion": "^14.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
