---
import Layout from "../layouts/Layout.astro";
import { safeLoginCallback } from "../lib/desktop-auth-protocol";
const callback = safeLoginCallback(
    Astro.url.searchParams.get("callback"),
    Astro.url.origin,
);
const isDesktopLogin =
    new URL(callback, Astro.url.origin).pathname === "/auth/desktop";
const errorCallback = isDesktopLogin
    ? `/auth/desktop-error?callback=${encodeURIComponent(callback)}`
    : Astro.url.pathname + Astro.url.search;
if (Astro.locals.user) return Astro.redirect(callback);
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<Layout>
    <main
        data-login-callback={callback}
        data-error-callback={errorCallback}
        data-desktop-login={isDesktopLogin ? "true" : "false"}
        id="login-page"
        class="w-full px-4 flex flex-col items-center justify-center w min-h-screen"
    >
        <div class="rounded-xl border w-full md:w-96 border-border bg-card md:p-8 p-2 text-card-foreground shadow-2xl">
            <div class="mb-8 text-center">
                <h1 class="mb-2 text-3xl font-bold text-headings">Audexis</h1>
                <p class="text-sm text-muted-foreground">
                    Sign in or create an account
                </p>
            </div>

            <p
                id="login-error"
                role="alert"
                class="mb-4 text-sm text-destructive"
                hidden
            ></p>
            <div class="mb-6 flex flex-col gap-3">
                <button
                    id="btn-github"
                    class="flex w-full items-center justify-center gap-2 rounded-md border border-border bg-secondary px-4 py-2.5 text-sm font-medium text-secondary-foreground transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="currentColor"
                    >
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    Continue with GitHub
                </button>

                <button
                    id="btn-google"
                    class="flex w-full items-center justify-center gap-2 rounded-md border border-border bg-secondary px-4 py-2.5 text-sm font-medium text-secondary-foreground transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="currentColor"
                    >
                        <path
                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                            fill="#4285F4"
                        />
                        <path
                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.16v2.84C3.99 20.53 7.7 23 12 23z"
                            fill="#34A853"
                        />
                        <path
                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.16C1.43 8.55 1 10.22 1 12s.43 3.45 1.16 4.93l2.85-2.22.83-.62z"
                            fill="#FBBC05"
                        />
                        <path
                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.16 7.07l3.68 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                            fill="#EA4335"
                        />
                    </svg>
                    Continue with Google
                </button>
            </div>
        </div>
    </main>

    <script>
        import { authClient } from "../lib/auth-client";

        const callbackURL =
            document.getElementById("login-page")?.dataset.loginCallback ??
            "/dashboard";
        const errorCallbackURL =
            document.getElementById("login-page")?.dataset.errorCallback ??
            "/login";
        const isDesktopLogin =
            document.getElementById("login-page")?.dataset.desktopLogin ===
            "true";

        async function signIn(provider: "github" | "google") {
            const error = document.getElementById(
                "login-error",
            ) as HTMLParagraphElement;
            const buttons = document.querySelectorAll<HTMLButtonElement>(
                "#btn-github, #btn-google",
            );
            error.hidden = true;
            buttons.forEach((button) => {
                button.disabled = true;
            });
            try {
                const result = await authClient.signIn.social({
                    provider,
                    callbackURL,
                    newUserCallbackURL: callbackURL,
                    errorCallbackURL,
                });
                if (result.error) throw new Error("Sign-in failed");
            } catch {
                if (isDesktopLogin) {
                    window.location.assign(errorCallbackURL);
                    return;
                }
                error.textContent = "Could not sign in. Please try again.";
                error.hidden = false;
            } finally {
                buttons.forEach((button) => {
                    button.disabled = false;
                });
            }
        }
        if (new URLSearchParams(window.location.search).has("error")) {
            const error = document.getElementById(
                "login-error",
            ) as HTMLParagraphElement;
            error.textContent =
                "Sign-in was cancelled or could not be completed. Please try again.";
            error.hidden = false;
        }
        document
            .getElementById("btn-github")
            ?.addEventListener("click", () => signIn("github"));
        document
            .getElementById("btn-google")
            ?.addEventListener("click", () => signIn("google"));
    </script>
</Layout>
