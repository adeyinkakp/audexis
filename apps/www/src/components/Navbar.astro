---
import { Image } from "astro:assets";

const user = Astro.locals.user;
---

<header class="border-b border-border/30 sticky top-0 z-50 bg-background/80 backdrop-blur-md h-24 md:h-18">
    <nav class="mx-auto flex mh-12 w-full max-w-7xl flex-wrap items-center justify-between gap-3 sm:gap-x-6 sm:gap-y-4 px-5 py-4 sm:px-8 lg:px-12">
        <a
            href="/"
            aria-label="Audexis home"
            class="flex items-center gap-1 sm:gap-3 font-mono text-foreground no-underline"
        >
            <Image
                src="/audexis-logo.png"
                alt=""
                width="36"
                height="36"
                class="size-7 sm:size-9"
            />
            <span class="text-base sm:text-xl font-semibold tracking-tight">
                Audexis
            </span>
        </a>

        <div class="flex items-center gap-3 text-xs sm:text-sm sm:gap-7">
            <a
                class="text-muted-foreground no-underline transition-colors hover:text-foreground motion-reduce:transition-none"
                href={`/docs`}
            >
                Docs
            </a>
            <a
                class="text-muted-foreground no-underline transition-colors hover:text-foreground motion-reduce:transition-none"
                href={"https://github.com/adeyinkakp/audexis"}
            >
                GitHub
            </a>

            {user ? (
                <div class="flex items-center gap-3 sm:gap-7">
                    <a
                        class="font-medium text-foreground transition-colors hover:text-primary no-underline"
                        href="/dashboard"
                    >
                        Dashboard
                    </a>
                    <button
                        id="web-logout"
                        type="button"
                        class="font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-50"
                    >
                        Log out
                    </button>
                </div>
            ) : (
                <a
                    class="font-medium text-muted-foreground transition-colors hover:text-foreground no-underline"
                    href="/login"
                >
                    Log in
                </a>
            )}

            <a
                class="no-underline rounded-lg bg-primary px-2.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-primary-foreground transition-colors motion-reduce:transition-none hover:bg-accent hover:text-accent-foreground"
                href="/download"
            >
                Download
            </a>
        </div>
    </nav>
    <p
        id="web-logout-error"
        role="alert"
        class="mx-auto max-w-7xl px-5 pb-3 text-sm text-destructive sm:px-8 lg:px-12"
        hidden
    ></p>
</header>

<script>
    import { authClient } from "../lib/auth-client";

    const button = document.getElementById(
        "web-logout",
    ) as HTMLButtonElement | null;
    button?.addEventListener("click", async () => {
        const error = document.getElementById(
            "web-logout-error",
        ) as HTMLParagraphElement;
        button.disabled = true;
        button.textContent = "Logging out…";
        error.hidden = true;
        try {
            const result = await authClient.signOut();
            if (result.error) throw new Error("Logout failed");
            window.location.assign("/");
        } catch {
            error.textContent = "Could not log out. Please try again.";
            error.hidden = false;
            button.disabled = false;
            button.textContent = "Log out";
        }
    });
</script>
