---
import type { MarkdownHeading } from "astro";
interface Props {
    headings: MarkdownHeading[];
}
const { headings } = Astro.props;
---

<nav class="docs-toc" aria-label="On this page">
    <ul>
        {headings.map((heading) => (
            <li class:list={{ "docs-toc-nested": heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
        ))}
    </ul>
</nav>

<script>
    const article = document.querySelector<HTMLElement>(".docs-content");
    const headings = Array.from(
        article?.querySelectorAll<HTMLElement>("h2[id], h3[id]") ?? [],
    );
    const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".docs-toc a"),
    );

    if (article && headings.length > 0) {
        let activeId: string | undefined;
        let pending = false;

        const update = () => {
            pending = false;
            const offset =
                parseFloat(
                    getComputedStyle(document.documentElement).scrollPaddingTop,
                ) || 0;
            let current: HTMLElement | undefined;

            for (const heading of headings) {
                const top = heading.getBoundingClientRect().top;
                if (top <= offset + 1) {
                    current = heading;
                } else {
                    if (!current && top < window.innerHeight) current = heading;
                    break;
                }
            }

            const pageHeight = document.documentElement.scrollHeight;
            if (
                pageHeight > window.innerHeight &&
                window.scrollY + window.innerHeight >= pageHeight - 2
            ) {
                current = headings[headings.length - 1];
            }

            if (current?.id === activeId) return;
            activeId = current?.id;
            for (const link of links) {
                if (decodeURIComponent(link.hash.slice(1)) === activeId) {
                    link.setAttribute("aria-current", "location");
                } else {
                    link.removeAttribute("aria-current");
                }
            }
        };

        const scheduleUpdate = () => {
            if (pending) return;
            pending = true;
            requestAnimationFrame(update);
        };

        window.addEventListener("scroll", scheduleUpdate, { passive: true });
        window.addEventListener("resize", scheduleUpdate);
        window.addEventListener("hashchange", scheduleUpdate);
        window.addEventListener("pageshow", scheduleUpdate);
        new ResizeObserver(scheduleUpdate).observe(document.body);
        update();
    }
</script>
