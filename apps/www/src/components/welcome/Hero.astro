---
import { Image } from "astro:assets";
---

<section class="pt-14 sm:pt-20 lg:pt-24">
    <div class="grid gap-7 lg:grid-cols-2 lg:items-end lg:gap-16">
        <h1 class="max-w-xl text-5xl font-medium leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
            A music player
            <br />
            for your own files.
        </h1>
        <div class="max-w-lg">
            <p class="text-lg leading-relaxed text-muted-foreground">
                Listen to your music, organize your library, and edit tags in
                one app. Add a folder to get started.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-5">
                <a
                    href="/download"
                    class="inline-flex min-h-12 items-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90"
                >
                    Download audexis
                </a>
                <a
                    href="https://github.com/adeyinkakp/audexis"
                    class="py-3 text-sm underline underline-offset-4 hover:text-primary"
                >
                    View source <span aria-hidden="true">↗</span>
                </a>
            </div>
            <p class="mt-5 text-xs text-muted-foreground">
                Free and open source · macOS, Windows, and Linux
            </p>
        </div>
    </div>
    <figure class="mt-10 rounded-2xl border border-border bg-card p-2 sm:mt-14 sm:p-5">
        <Image
            src="/screenshots/home.png"
            width="2850"
            height="1846"
            alt="Audexis library with recently played music, albums, and synced lyrics."
            fetchpriority="high"
            loading="eager"
            class="h-auto w-full"
        />
        <figcaption class="px-3 pb-2 pt-3 text-xs text-muted-foreground sm:flex sm:justify-between">
            <span>Your library, recently played music, and lyrics.</span>
            <a href="#explore" class="mt-2 block hover:text-primary sm:mt-0">
                Explore the app <span aria-hidden="true">↓</span>
            </a>
        </figcaption>
    </figure>
</section>
