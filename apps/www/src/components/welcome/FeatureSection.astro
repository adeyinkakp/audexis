---
import { Image } from "astro:assets";

interface Props {
    eyebrow: string;
    title: string;
    description: string;
    imagePosition?: "left" | "right";
    image: { src: string; alt: string; width: number; height: number };
}
const {
    eyebrow,
    title,
    description,
    imagePosition = "right",
    image,
} = Astro.props;
---

<section class="grid items-center gap-8 py-12 lg:grid-cols-5 lg:gap-16 lg:py-20">
    <div
        class:list={[
            "lg:col-span-2",
            { "lg:col-start-4 lg:row-start-1": imagePosition === "left" },
        ]}
    >
        <p class="mb-4 font-mono text-xs text-primary">{eyebrow}</p>
        <h2 class="text-3xl font-medium leading-tight tracking-tight sm:text-4xl">
            {title}
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">
            {description}
        </p>
        <slot />
    </div>
    <div
        class:list={[
            "min-w-0 rounded-2xl border border-border bg-card p-4 sm:p-6 lg:col-span-3",
            { "lg:col-start-1 lg:row-start-1": imagePosition === "left" },
        ]}
    >
        <Image
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
            class="h-auto w-full"
        />
    </div>
</section>
