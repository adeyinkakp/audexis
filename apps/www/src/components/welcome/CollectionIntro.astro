---
const features = [
    {
        title: "Browse your library",
        description:
            "Find music by album, artist, or song. Add favorites and build playlists from your collection.",
    },
    {
        title: "Edit your files",
        description:
            "Fix titles, update album artwork, and change tags for one song or a selection of songs.",
    },
    {
        title: "Listen offline",
        description:
            "Play music stored on your computer without signing in or uploading it first.",
    },
];
---

<section
    id="explore"
    aria-label="Library features"
    class="grid gap-8 border-b border-border py-12 md:grid-cols-3 md:gap-10 lg:py-16"
>
    {features.map(({ title, description }, index) => (
        <article>
            <span class="font-mono text-xs text-primary">0{index + 1}</span>
            <h2 class="mb-3 mt-4 text-xl font-medium tracking-tight">
                {title}
            </h2>
            <p class="text-sm leading-relaxed text-muted-foreground">
                {description}
            </p>
        </article>
    ))}
    <p class="text-sm leading-relaxed text-muted-foreground md:col-span-3">
        <span class="font-medium text-foreground">Supported formats</span>
        <span class="ml-2">MP3, FLAC, M4A, AAC, Ogg Vorbis, Opus, WAV, and AIFF.</span>
    </p>
</section>
