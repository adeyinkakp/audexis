---
import type { HTMLAttributes } from "astro/types";

interface Option {
    value: string;
    label: string;
    disabled?: boolean;
}

interface OptionGroup {
    label: string;
    options: Option[];
}

interface Props extends Omit<
    HTMLAttributes<"select">,
    "id" | "value" | "multiple" | "size"
> {
    id: string;
    label?: string;
    options: (Option | OptionGroup)[];
    value?: string;
    placeholder?: string;
}

const {
    id,
    label,
    options,
    value,
    placeholder = "Select an option",
    class: className,
    ...attributes
} = Astro.props;
let optionIndex = 0;
const groups = options.map((entry) => ({
    label: "options" in entry ? entry.label : undefined,
    options: ("options" in entry ? entry.options : [entry]).map((option) => ({
        ...option,
        index: optionIndex++,
    })),
}));
const selected = groups
    .flatMap((group) => group.options)
    .find((option) => option.value === value);
const accessibleLabel = attributes["aria-label"] ?? label ?? placeholder;
---

<div class="relative block" data-dropdown>
    <select {...attributes} hidden tabindex="-1" aria-hidden="true" data-select>
        <option value="" disabled selected={!selected}>
            {placeholder}
        </option>
        {groups.map((group) =>
            group.label ? (
                <optgroup label={group.label}>
                    {group.options.map((option) => (
                        <option
                            value={option.value}
                            disabled={option.disabled}
                            selected={value === option.value}
                        >
                            {option.label}
                        </option>
                    ))}
                </optgroup>
            ) : (
                group.options.map((option) => (
                    <option
                        value={option.value}
                        disabled={option.disabled}
                        selected={value === option.value}
                    >
                        {option.label}
                    </option>
                ))
            ),
        )}
    </select>
    <button
        id={id}
        type="button"
        role="combobox"
        aria-label={accessibleLabel}
        aria-controls={`${id}-options`}
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-required={attributes.required ? "true" : undefined}
        disabled={attributes.disabled}
        class:list={[
            "flex w-full items-center justify-between gap-3 rounded-md border border-border bg-input px-3 py-2 text-left text-sm text-foreground transition-colors hover:border-ring focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50",
            className,
        ]}
        data-trigger
    >
        <span
            class:list={["truncate", { "text-muted-foreground": !selected }]}
            data-value
        >
            {selected?.label ?? placeholder}
        </span>
        <svg
            class="size-4 shrink-0 text-muted-foreground transition-transform"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <path d="m6 9 6 6 6-6" />
        </svg>
    </button>
    <ul
        id={`${id}-options`}
        role="listbox"
        aria-label={accessibleLabel}
        hidden
        class="absolute top-full z-50 mt-1.5 max-h-60 w-full overflow-y-auto rounded-md border border-border bg-popover p-1 text-sm text-popover-foreground shadow-lg"
        data-list
    >
        {groups.map((group, groupIndex) => (
            <li
                role="presentation"
                class:list={[
                    {
                        "mt-1 border-t border-border pt-1":
                            groupIndex > 0 && group.label,
                    },
                ]}
            >
                {group.label && (
                    <div
                        id={`${id}-group-${groupIndex}`}
                        class="px-2.5 py-2 text-xs font-semibold text-muted-foreground"
                    >
                        {group.label}
                    </div>
                )}
                <ul
                    role={group.label ? "group" : "presentation"}
                    aria-labelledby={
                        group.label ? `${id}-group-${groupIndex}` : undefined
                    }
                    class="m-0 list-none p-0"
                >
                    {group.options.map((option) => (
                        <li
                            id={`${id}-option-${option.index}`}
                            role="option"
                            aria-selected={
                                value === option.value ? "true" : "false"
                            }
                            aria-disabled={option.disabled ? "true" : undefined}
                            data-index={option.index}
                            class="flex cursor-pointer items-center justify-between gap-3 rounded px-2.5 py-2"
                        >
                            <span>{option.label}</span>
                            <svg
                                class="check size-4 shrink-0"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                aria-hidden="true"
                            >
                                <path d="m5 12 4 4L19 6" />
                            </svg>
                        </li>
                    ))}
                </ul>
            </li>
        ))}
    </ul>
</div>

<style>
    [data-trigger][aria-expanded="true"] svg {
        transform: rotate(180deg);
    }
    [role="option"][data-active="true"] {
        background: var(--accent);
        color: var(--accent-foreground);
    }
    [role="option"][aria-disabled="true"] {
        opacity: 0.4;
        cursor: not-allowed;
    }
    [role="option"] .check {
        visibility: hidden;
    }
    [role="option"][aria-selected="true"] .check {
        visibility: visible;
    }
</style>

<script>
    let controller: AbortController;

    function initializeDropdowns() {
        controller?.abort();
        controller = new AbortController();
        const { signal } = controller;
        document
            .querySelectorAll<HTMLElement>("[data-dropdown]")
            .forEach((dropdown) => {
                const select =
                    dropdown.querySelector<HTMLSelectElement>("[data-select]")!;
                const trigger =
                    dropdown.querySelector<HTMLButtonElement>(
                        "[data-trigger]",
                    )!;
                const display =
                    dropdown.querySelector<HTMLElement>("[data-value]")!;
                const list =
                    dropdown.querySelector<HTMLUListElement>("[data-list]")!;
                const items = Array.from(
                    list.querySelectorAll<HTMLElement>("[role=option]"),
                );
                const enabled = items.filter(
                    (item) => item.getAttribute("aria-disabled") !== "true",
                );
                let active = -1;
                let search = "";
                let lastKey = 0;

                const highlight = (index: number) => {
                    active = index;
                    items.forEach((item) => {
                        item.dataset.active = String(item === enabled[active]);
                    });
                    const item = enabled[active];
                    if (item) {
                        trigger.setAttribute("aria-activedescendant", item.id);
                        item.scrollIntoView({ block: "nearest" });
                    } else trigger.removeAttribute("aria-activedescendant");
                };
                const close = () => {
                    list.hidden = true;
                    trigger.setAttribute("aria-expanded", "false");
                    trigger.removeAttribute("aria-activedescendant");
                    search = "";
                };
                const open = () => {
                    if (trigger.disabled) return;
                    list.hidden = false;
                    trigger.setAttribute("aria-expanded", "true");
                    const selected = enabled.findIndex(
                        (item) =>
                            Number(item.dataset.index) + 1 ===
                            select.selectedIndex,
                    );
                    highlight(selected < 0 ? 0 : selected);
                };
                const sync = () => {
                    display.textContent =
                        select.selectedOptions[0]?.textContent ?? "";
                    display.classList.toggle(
                        "text-muted-foreground",
                        select.selectedIndex <= 0,
                    );
                    items.forEach((item) =>
                        item.setAttribute(
                            "aria-selected",
                            String(
                                Number(item.dataset.index) + 1 ===
                                    select.selectedIndex,
                            ),
                        ),
                    );
                    trigger.removeAttribute("aria-invalid");
                };
                const choose = (item: HTMLElement) => {
                    if (item.getAttribute("aria-disabled") === "true") return;
                    select.selectedIndex = Number(item.dataset.index) + 1;
                    sync();
                    close();
                    trigger.focus();
                    select.dispatchEvent(new Event("input", { bubbles: true }));
                    select.dispatchEvent(
                        new Event("change", { bubbles: true }),
                    );
                };
                trigger.addEventListener(
                    "click",
                    () => (list.hidden ? open() : close()),
                    { signal },
                );
                trigger.addEventListener(
                    "keydown",
                    (event) => {
                        if (event.key === "Tab") {
                            close();
                            return;
                        }
                        if (event.key === "Escape") {
                            event.preventDefault();
                            close();
                            return;
                        }
                        if (
                            [
                                "ArrowDown",
                                "ArrowUp",
                                "Home",
                                "End",
                                "Enter",
                                " ",
                            ].includes(event.key)
                        ) {
                            event.preventDefault();
                            if (list.hidden) {
                                open();
                                if (
                                    event.key === "ArrowUp" ||
                                    event.key === "End"
                                )
                                    highlight(enabled.length - 1);
                                return;
                            }
                            if (event.key === "Enter" || event.key === " ") {
                                if (enabled[active]) choose(enabled[active]);
                                return;
                            }
                            if (event.key === "Home") highlight(0);
                            else if (event.key === "End")
                                highlight(enabled.length - 1);
                            else
                                highlight(
                                    Math.max(
                                        0,
                                        Math.min(
                                            enabled.length - 1,
                                            active +
                                                (event.key === "ArrowDown"
                                                    ? 1
                                                    : -1),
                                        ),
                                    ),
                                );
                        } else if (
                            event.key.length === 1 &&
                            !event.ctrlKey &&
                            !event.metaKey &&
                            !event.altKey
                        ) {
                            event.preventDefault();
                            if (list.hidden) open();
                            const now = Date.now();
                            search =
                                (now - lastKey > 700 ? "" : search) +
                                event.key.toLowerCase();
                            lastKey = now;
                            const index = enabled.findIndex((item) =>
                                item.textContent
                                    ?.trim()
                                    .toLowerCase()
                                    .startsWith(search),
                            );
                            if (index >= 0) highlight(index);
                        }
                    },
                    { signal },
                );
                list.addEventListener(
                    "pointerdown",
                    (event) => event.preventDefault(),
                    { signal },
                );
                items.forEach((item) => {
                    item.addEventListener("click", () => choose(item), {
                        signal,
                    });
                    item.addEventListener(
                        "pointermove",
                        () => {
                            const index = enabled.indexOf(item);
                            if (index >= 0) highlight(index);
                        },
                        { signal },
                    );
                });
                document.addEventListener(
                    "pointerdown",
                    (event) => {
                        if (!dropdown.contains(event.target as Node)) close();
                    },
                    { signal },
                );
                dropdown.addEventListener(
                    "focusout",
                    (event) => {
                        if (
                            !dropdown.contains(
                                event.relatedTarget as Node | null,
                            )
                        )
                            close();
                    },
                    { signal },
                );
                select.addEventListener("change", sync, { signal });
                select.addEventListener(
                    "invalid",
                    (event) => {
                        event.preventDefault();
                        trigger.setAttribute("aria-invalid", "true");
                        trigger.focus();
                    },
                    { signal },
                );
                select.form?.addEventListener(
                    "reset",
                    () => {
                        setTimeout(() => {
                            if (!signal.aborted) {
                                sync();
                                close();
                            }
                        }, 0);
                    },
                    { signal },
                );
                sync();
                close();
            });
    }

    initializeDropdowns();
    document.addEventListener("astro:page-load", initializeDropdowns);
    document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
