<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UILaunchStoryboardName</key>
    <string>AudexisIconLaunch</string>
    <key>AudexisAuthOrigin</key>
    <string>$(AUDEXIS_AUTH_ORIGIN)</string>
    <key>AudexisAPIOrigin</key>
    <string>$(AUDEXIS_API_ORIGIN)</string>
    <key>UIBackgroundModes</key>
    <array><string>audio</string></array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to your music server on your local network.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.kp.audexis.auth</string>
            <key>CFBundleURLSchemes</key>
            <array><string>audexis</string></array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
