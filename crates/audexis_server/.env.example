# PostgreSQL database must exist
DATABASE_URL="postgresql://user:pass@localhost:5432/audexis_media"

# Listener. Use an HTTPS reverse proxy in production.
AUDEXIS_BIND=127.0.0.1:3000
AUDEXIS_PUBLIC_ORIGIN=http://localhost:3000
AUDEXIS_TRUSTED_PROXIES=

# Server mode verifies incoming uploads on disk
# Direct mode sends straight to media server n downloads file for verification
# server is recommended but if bandwidth is a concern go for direct
# Give the ingest directory persistent storage and sufficient free disk space.
AUDEXIS_UPLOAD_MODE=server
AUDEXIS_INGEST_DIR=./data/ingest
AUDEXIS_INGEST_MAX_BYTES=20000000000

# Optional AAC 128/256 kbps streaming copies. Install FFmpeg on the server and
# AUDEXIS_FFMPEG_PATH=/usr/bin/ffmpeg
AUDEXIS_VARIANT_INPUT_DIR=./data/variant-input
AUDEXIS_VARIANT_INPUT_CACHE_BYTES=5000000000

# Audexis website used to verify API keys and active subscriptions.
AUDEXIS_AUTH_ORIGIN=

# Self-hosted: leave AUDEXIS_AUTH_ORIGIN empty and run:
# cargo run -p audexis_server -- users create peezy --quota 100GB
# Use users --help for account/key management. Changes need no server restart.

# Per-account storage quota and maximum single-file size, in bytes.
AUDEXIS_QUOTA_BYTES=100000000000
AUDEXIS_MAX_FILE_BYTES=1073741824

# Private B2 bucket with read, write, list, and delete-file capabilities.
# Replace the example endpoint and region with your bucket's values.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-private-bucket
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key

# Optional local storage Setting AUDEXIS_STORAGE_DIR replaces B2.
# AUDEXIS_STORAGE_DIR=./media
# AUDEXIS_PUBLIC_ORIGIN=http://localhost:3000

# shout out gtt
