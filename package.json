{
  "name": "audexis",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter desktop run tauri dev",
    "www": "pnpm --filter www run dev",
    "typecheck": "pnpm --filter desktop run typecheck",
    "build": "pnpm --filter desktop run build",
    "format:check": "pnpm --filter desktop run format:check",
    "check:rust": "pnpm --filter desktop run check:rust",
    "clippy": "pnpm --filter desktop run clippy",
    "test": "pnpm run test:frontend && pnpm --filter desktop run test:rust",
    "validate:frontend": "pnpm --filter desktop run validate:frontend",
    "validate:rust": "pnpm --filter desktop run validate:rust",
    "validate": "pnpm --filter desktop run validate",
    "test:release": "act -W .github/workflows/release.yml -P macos-latest=-self-hosted  --matrix platform:macos-latest",
    "test:frontend": "pnpm --filter desktop run test:frontend"
  },
  "dependencies": {
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  }
}
