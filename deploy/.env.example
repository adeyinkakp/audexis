
# Put ur postgres pass
POSTGRES_PASSWORD=

# Use ur externally reachable HTTPS API address in production.
AUDEXIS_PUBLIC_ORIGIN=http://localhost:3000
AUDEXIS_UPLOAD_MODE=server
AUDEXIS_INGEST_MAX_BYTES=10000000000
AUDEXIS_VARIANT_INPUT_CACHE_BYTES=2000000000
AUDEXIS_QUOTA_BYTES=100000000000
AUDEXIS_MAX_FILE_BYTES=1073741824

# Leave empty for self hosted accounts managed with the users command.
AUDEXIS_AUTH_ORIGIN=
AUDEXIS_TRUSTED_PROXIES=

# To use B2 Un comment all these values
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=

# using
AUDEXIS_STORAGE_DIR=/app/data/media
